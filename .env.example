# ==========================================================
#  Salon System - Environment Variables (TAR Solutions)
#  Copy this file to ".env" and fill real values.
#  These are secrets that must NEVER be committed or stored
#  in the database.
# ==========================================================

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/salon?retryWrites=true&w=majority

# --- Auth (JWT) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- SMS Gateway (Sri Lankan gateway - e.g. text.lk / notify.lk) ---
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=

# --- Cloudinary (image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Vercel Cron protection (used to secure /api/cron/* routes) ---
CRON_SECRET=change_this_too

# --- App ---
# Public base url, used when generating links inside SMS if needed
NEXT_PUBLIC_BASE_URL=http://localhost:3000
